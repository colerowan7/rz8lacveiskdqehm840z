# Copy this file to `.env` and fill in your real values.
# Never commit the real `.env` file to git or share it with anyone.

LEAGUE_ID=1934807293
YEAR=2026

# From fantasy.espn.com cookies (DevTools > Application > Cookies)
ESPN_S2=
SWID=

# Optional: run `python scripts/pull_league_data.py` once without this set,
# note which number your team is from the printed list, then set it here
# to skip the prompt on future runs.
MY_TEAM_INDEX=

# Optional: only needed for scripts/ai_insights.py (real AI judgment on
# close calls). Get a key at console.anthropic.com. Skip this and
# everything else still works, just without that extra layer.
ANTHROPIC_API_KEY=
